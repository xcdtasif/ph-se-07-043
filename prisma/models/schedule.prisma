// A planned power cut on one feeder. A Zone Manager adds TENTATIVE slots for the week ahead, then
// confirms each day's. Slots are never deleted, only cancelled, so the history stays
model LoadSheddingSlot {
  id          String     @id @default(uuid())
  feederId    String     @map("feeder_id")
  startsAt    DateTime   @map("starts_at")
  endsAt      DateTime   @map("ends_at")
  status      SlotStatus @default(TENTATIVE)
  createdById String     @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  feeder    Feeder @relation(fields: [feederId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([feederId, startsAt])
  @@map("load_shedding_slots")
}

enum SlotStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
}
