/**
 * A job opening in one zone. A Zone Manager posts TECHNICIAN jobs for their zone; an admin posts
 * ZONE_MANAGER jobs. Applying closes when the posting is CLOSED or after its deadline, a Dhaka
 * calendar day, ends; reads work that out from the date, so no job has to close it
 */
model JobPosting {
  id             String           @id @default(uuid())
  zoneId         String           @map("zone_id")
  role           EmployeeRole
  title          String
  description    String
  vacancies      Int
  // Whole taka, charged when applying
  applicationFee Int              @map("application_fee")
  deadline       DateTime         @db.Date
  status         JobPostingStatus @default(OPEN)
  createdById    String           @map("created_by_id")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  zone         Zone          @relation(fields: [zoneId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  applications Application[]

  @@index([zoneId, role, status, deadline])
  @@map("job_postings")
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

/**
 * A user's application for a job posting, with their phone and a PDF CV on Cloudinary. It waits
 * for the fee (PAYMENT_PENDING) and is SUBMITTED once paid; the poster then shortlists, hires or
 * rejects it
 */
model Application {
  id           String            @id @default(uuid())
  jobPostingId String            @map("job_posting_id")
  userId       String            @map("user_id")
  phone        String
  cvUrl        String            @map("cv_url")
  // Deletes the file if the application is never saved
  cvPublicId   String            @map("cv_public_id")
  status       ApplicationStatus @default(PAYMENT_PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  payments   Payment[]

  @@unique([jobPostingId, userId])
  @@index([jobPostingId, status])
  @@index([userId])
  @@map("applications")
}

enum ApplicationStatus {
  PAYMENT_PENDING
  SUBMITTED
  SHORTLISTED
  HIRED
  REJECTED
}

/**
 * One Stripe Checkout session for an application's fee. Only the signed webhook changes its
 * status: COMPLETED submits the application, FAILED (the session expired) lets the user pay again
 */
model Payment {
  id              String        @id @default(uuid())
  applicationId   String        @map("application_id")
  // Whole taka, the posting's fee when the checkout opened
  amount          Int
  // Lowercase ISO code, as Stripe takes it
  currency        String        @default("bdt")
  status          PaymentStatus @default(PENDING)
  stripeSessionId String        @map("stripe_session_id")
  paymentIntentId String?       @map("payment_intent_id")
  paidAt          DateTime?     @map("paid_at")
  // Set with COMPLETED, e.g. GL-20261127-3F2A9C1D
  invoiceNumber   String?       @map("invoice_number")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@unique([stripeSessionId])
  @@unique([invoiceNumber])
  @@index([applicationId, status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
