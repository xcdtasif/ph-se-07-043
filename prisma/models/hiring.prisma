/**
 * A job opening in one zone. A Zone Manager posts TECHNICIAN jobs for their zone; an admin posts
 * ZONE_MANAGER jobs. Applying closes when the posting is CLOSED or after its deadline, a Dhaka
 * calendar day, ends; reads work that out from the date, so no job has to close it
 */
model JobPosting {
  id             String           @id @default(uuid())
  zoneId         String           @map("zone_id")
  role           EmployeeRole
  title          String
  description    String
  vacancies      Int
  // Whole taka, charged when applying
  applicationFee Int              @map("application_fee")
  deadline       DateTime         @db.Date
  status         JobPostingStatus @default(OPEN)
  createdById    String           @map("created_by_id")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  zone      Zone @relation(fields: [zoneId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([zoneId, role, status, deadline])
  @@map("job_postings")
}

enum JobPostingStatus {
  OPEN
  CLOSED
}
