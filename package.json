{
  "name": "ph-se-07-043",
  "version": "0.1.0",
  "description": "GridLine: load-shedding schedules, outage handling and technician hiring for a power distribution company",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma format && prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:delete": "tsx src/db/delete.ts",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "vc:env-sync": "bash scripts/vercel-env-sync.sh"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@upstash/ratelimit": "^2.2.2",
    "@upstash/redis": "^1.41.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prisma": "7.10.1",
    "prisma-erd-generator": "^3.2.1",
    "puppeteer": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.23.0"
}
